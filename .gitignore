# StaTech Industry 2: Exodus — modpack source
#
# Tracked: manifest.json, modlist.html and everything that goes into
# the CurseForge zip "overrides" folder (config/, kubejs/, defaultconfigs/,
# and mods/ for the few jars that are not downloadable from CurseForge).
# Mods, resource packs and shaders listed in manifest.json are downloaded
# by CurseForge on import and are NOT stored here.

# Minecraft runtime files
saves/
logs/
crash-reports/
screenshots/
backups/
downloads/
local/
journeymap/
XaeroWorldMap/
XaeroWaypoints/
Distant_Horizons_server_data/
ftbbackups3/
modernfix/
.mixin.out/
dynamic-resource-pack-cache/
dynamic-data-pack-cache/
/options.txt
servers.dat
servers.dat_old
usercache.json
usernamecache.json
command_history.txt
ponders_watched.json

# CurseForge instance metadata (machine specific)
minecraftinstance.json
.curseclient

# Content downloaded by CurseForge from manifest.json
resourcepacks/
shaderpacks/

# Build output
build/
*.bak

# ProbeJS
/kubejs/probe/

# OS / editor
Thumbs.db
Desktop.ini
.DS_Store
/.vscode/*
!/.vscode/*.code-workspace
